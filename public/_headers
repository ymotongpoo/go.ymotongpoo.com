/pbt/llms.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/llms.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/ja/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/*
