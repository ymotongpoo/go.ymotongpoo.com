# Responses for AI agents. The Markdown version of every guide page and the
# llms.txt files are served as text/markdown, every guide page points at the
# index that describes it, and Content-Signal allows search and use as AI
# input (the training signal is left unstated). Rules apply to the request
# path; a request that matches several rules gets the headers of all.
/*.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/markdown; charset=utf-8
/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/llms.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/llms.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/ja/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
/pbt/guide/*
  Link: </pbt/llms.txt>; rel="describedby"; type="text/markdown"
  Content-Signal: search=yes, ai-input=yes
