# go.ymotongpoo.com: vanity import paths for Go modules, plus the pbt guide.
# Rules apply in order, the first match wins, and they take precedence over
# static assets. Exact paths come first, then the splats; a destination that
# names an index.html or .html file is rejected as a loop by the rule
# validator, so destinations are clean URLs or non-HTML files. The go-import
# page is stored under /goimport, outside the /pbt pattern.
/pbt/guide         /pbt/guide/               301
/pbt/guide/ja      /pbt/guide/ja/            301
# The llms.txt index and the whole guide in one file, for AI agents; see
# https://llmstxt.org/. They live with the guide and are served at the root
# and under /pbt as well.
/llms.txt          /guide/pbt/llms.txt       200
/llms-full.txt     /guide/pbt/llms-full.txt  200
/pbt/llms.txt      /guide/pbt/llms.txt       200
/pbt/llms-full.txt /guide/pbt/llms-full.txt  200
/pbt               /goimport/pbt/            200
/pbt/guide/*       /guide/pbt/:splat         200
/pbt/*             /goimport/pbt/            200
